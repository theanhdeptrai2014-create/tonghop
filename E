-- ===== ÁP DỤNG TỐI ƯU =====
local function applyOpt()
    -- Siêu Anti Lag
    if opt.antiLag then
        Lighting.GlobalShadows=false Lighting.FogEnd=9e9 Lighting.FogStart=9e9
        Lighting.Brightness=0 Lighting.Outlines=false
        pcall(function() settings().Rendering.QualityLevel=1 end)
        local t=WS.Terrain t.WaterWaveSize=0 t.WaterWaveSpeed=0
        local n=0
        for _,o in pairs(WS:GetDescendants()) do
            n=n+1 if n>2000 then break end
            if o:IsA("ParticleEmitter")or o:IsA("Smoke")or o:IsA("Fire")or o:IsA("Sparkles")or o:IsA("Beam")or o:IsA("Trail") then o.Enabled=false end
            if o:IsA("BasePart")and not o:IsDescendantOf(plr.Character) then o.Material=Enum.Material.Plastic o.Reflectance=0 end
        end
    end
    
    -- Xóa Răng Cưa
    if opt.antiAlias then
        pcall(function() settings().Rendering.AntiAliasingQuality=Enum.AntiAliasingQuality.Off end)
    end
    
    -- Tắt Global Shadows
    if opt.noShadow then Lighting.GlobalShadows=false end
    
    -- Xóa Texture
    if opt.noTexture then
        for _,o in pairs(WS:GetDescendants()) do if o:IsA("Texture")or o:IsA("Decal") then o:Destroy() end end
    end
    
    -- Tắt Hiệu Ứng
    if opt.noEffect then
        for _,v in pairs(Lighting:GetChildren()) do
            if v:IsA("BloomEffect")or v:IsA("SunRaysEffect")or v:IsA("ColorCorrectionEffect")or v:IsA("BlurEffect")or v:IsA("DepthOfFieldEffect") then v.Enabled=false end
        end
    end
    
    -- Xóa Cỏ
    if opt.noGrass then
        for _,o in pairs(WS:GetDescendants()) do if o:IsA("BasePart") and o.Material==Enum.Material.Grass then o.Material=Enum.Material.Plastic end end
    end
    
    -- Xóa Sương Mù
    if opt.noFog then Lighting.FogEnd=9e9 Lighting.FogStart=9e9 end
    
    -- Xóa Atmosphere
    if opt.noAtmos then for _,v in pairs(Lighting:GetChildren()) do if v:IsA("Atmosphere") then v.Enabled=false end end end
    
    -- Giảm Render Distance
    if opt.lowRender then pcall(function() settings().Rendering.RenderDistance=1 end) end
    
    -- Xóa Nước
    if opt.noWater then
        local t=WS.Terrain t.WaterWaveSize=0 t.WaterWaveSpeed=0 t.WaterReflectance=0 t.WaterTransparency=1
    end
    
    -- Xóa Decals
    if opt.noDecal then for _,o in pairs(WS:GetDescendants()) do if o:IsA("Decal") then o:Destroy() end end end
    
    -- Xóa Cây Cối
    if opt.noTree then
        for _,o in pairs(WS:GetDescendants()) do
            if o:IsA("BasePart") and o.Name:lower():find("tree") or o.Name:lower():find("trunk") or o.Name:lower():find("wood") then o.Transparency=1 end
        end
    end
    
    -- Xóa Lá Cây
    if opt.noLeaf then
        for _,o in pairs(WS:GetDescendants()) do
            if o:IsA("BasePart") and (o.Name:lower():find("leaf") or o.Name:lower():find("leaves") or o.Material==Enum.Material.LeafyGrass) then o.Transparency=1 end
        end
    end
    
    -- Xóa Bầu Trời
    if opt.noSky then for _,v in pairs(Lighting:GetChildren()) do if v:IsA("Sky") then v.Enabled=false end end end
    
    -- Xóa Ghế
    if opt.noSeat then for _,o in pairs(WS:GetDescendants()) do if o:IsA("Seat") then o:Destroy() end end end
    
    -- Tắt Bloom
    if opt.noBloom then for _,v in pairs(Lighting:GetChildren()) do if v:IsA("BloomEffect") then v.Enabled=false end end end
    
    -- Tắt SunRays
    if opt.noSunRay then for _,v in pairs(Lighting:GetChildren()) do if v:IsA("SunRaysEffect") then v.Enabled=false end end end
    
    -- Tắt ColorCorrection
    if opt.noColorCor then for _,v in pairs(Lighting:GetChildren()) do if v:IsA("ColorCorrectionEffect") then v.Enabled=false end end end
    
    -- Tắt Post Processing
    if opt.noPost then for _,v in pairs(Lighting:GetChildren()) do if v:IsA("PostEffect") then v.Enabled=false end end end
    
    -- Giảm Độ Sáng
    if opt.lowBright then Lighting.Brightness=0 end
    
    -- Tắt Tất Cả Bóng
    if opt.noAllShadow then Lighting.GlobalShadows=false Lighting.ShadowSoftness=0 end
    
    -- Mở Khóa FPS
    if opt.unlockFPS then pcall(function() settings().Rendering.FrameRate=999 end) end
    
    -- Tắt Nhạc Nền
    if opt.noMusic then
        for _,o in pairs(WS:GetDescendants()) do if o:IsA("Sound") and (o.Name:lower():find("music")or o.Name:lower():find("bgm")) then o:Destroy() end end
    end
    
    -- Tắt Tất Cả Âm Thanh
    if opt.noSound then for _,o in pairs(WS:GetDescendants()) do if o:IsA("Sound") then o.Volume=0 end end end
    
    -- Xóa Vật Phẩm
    if opt.delItem then
        for _,o in pairs(WS:GetDescendants()) do if o:IsA("BasePart") and (o.Name:lower():find("item")or o.Name:lower():find("prop")) then o:Destroy() end end
    end
    
    -- Xóa Khối
    if opt.delBlock then
        for _,o in pairs(WS:GetDescendants()) do if o:IsA("BasePart") and o.Size.Magnitude>50 and o.Anchored then o.Transparency=1 end end
    end
    
    -- Auto Pick
    if opt.autoPick then
        if conns.pick then conns.pick:Disconnect() end
        conns.pick=RS.Heartbeat:Connect(function()
            if not opt.autoPick then conns.pick:Disconnect() conns.pick=nil return end
            local c=plr.Character if not c then return end
            local r=c:FindFirstChild("HumanoidRootPart") if not r then return end
            for _,o in pairs(WS:GetDescendants()) do
                if o:IsA("BasePart") and o:FindFirstChildOfClass("ProximityPrompt") then
                    if (r.Position-o.Position).Magnitude<10 then
                        fireproximityprompt(o:FindFirstChildOfClass("ProximityPrompt"))
                    end
                end
            end
            task.wait(0.5)
        end)
    end
    
    -- Dọn Terrain
    if opt.cleanTerrain then WS.Terrain:Clear() end
    
    -- Dọn Workspace
    if opt.cleanWS then
        for _,o in pairs(WS:GetChildren()) do if o:IsA("BasePart") and o.Anchored and o.Size.Magnitude>100 then o:Destroy() end end
    end
end

local function restoreOpt()
    Lighting.GlobalShadows=true Lighting.FogEnd=100000 Lighting.Brightness=1
    pcall(function() settings().Rendering.QualityLevel=10 end)
end

