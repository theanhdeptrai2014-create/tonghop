local function btn(container, name, key, callback)
    local b = Instance.new("TextButton", container)
    b.Size = UDim2.new(0.92,0,0,30) b.BackgroundColor3 = Color3.fromRGB(28,28,42) b.Text = "" b.BorderSizePixel = 0 b.AutoButtonColor = false
    Instance.new("UICorner",b).CornerRadius = UDim.new(0,5)
    local sk = Instance.new("UIStroke",b) sk.Color = Color3.fromRGB(55,55,75) sk.Thickness = 0.5
    local ic = Instance.new("TextLabel",b) ic.Size = UDim2.new(0,20,1,0) ic.BackgroundTransparency = 1 ic.Text = "🔴" ic.TextSize = 9
    local lb = Instance.new("TextLabel",b) lb.Size = UDim2.new(1,-22,1,0) lb.Position = UDim2.new(0,22,0,0) lb.BackgroundTransparency = 1 lb.Text = name lb.TextColor3 = Color3.fromRGB(175,175,195) lb.Font = Enum.Font.GothamBold lb.TextSize = 10 lb.TextXAlignment = Enum.TextXAlignment.Left
    menuBtns[key] = {icon=ic,lbl=lb,stk=sk}
    b.MouseButton1Click:Connect(function()
        local cur
        if fe[key]~=nil then cur=not fe[key] callback(cur) sync(key,cur)
        elseif opt[key]~=nil then cur=not opt[key] applyOpt() sync(key,cur) end
    end)
end

