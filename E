    for k in pairs(opt) do opt[k]=false end
    fly(false) aim(false) combat(false) esp(false) hb(false) dmg(false) speedHack(false) jumpHack(false)
    for _,c in pairs(conns) do if c and type(c)=="userdata" then c:Disconnect() end end
    for _,d in pairs(hbList) do if d.p then d.p:Destroy() end end
    restoreOpt()
    if wm then wm:Destroy() end if menu then menu:Destroy() end
end

