-- ===== FLY =====
local function fly(on)
    if on then
        local c=plr.Character if not c then sync("fly",false) return end
        local r=c:FindFirstChild("HumanoidRootPart") if not r then sync("fly",false) return end
        if flyBV then flyBV:Destroy() end if flyBG then flyBG:Destroy() end if conns.fly then conns.fly:Disconnect() end
        
        flyBV=Instance.new("BodyVelocity",r) flyBV.MaxForce=Vector3.new(1e9,1e9,1e9) flyBV.Velocity=Vector3.zero
        flyBG=Instance.new("BodyGyro",r) flyBG.MaxTorque=Vector3.new(1e9,1e9,1e9) flyBG.D=500 flyBG.P=3000
        
        conns.fly=RS.RenderStepped:Connect(function()
            if not fe.fly or not c.Parent or not r.Parent then conns.fly:Disconnect() conns.fly=nil if flyBV then flyBV:Destroy() flyBV=nil end if flyBG then flyBG:Destroy() flyBG=nil end sync("fly",false) return end
            local d=Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then d+=r.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then d-=r.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then d-=r.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then d+=r.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then d+=Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then d+=Vector3.new(0,-1,0) end
            if d.Magnitude>0 then d=d.Unit end
            local s=UIS:IsKeyDown(Enum.KeyCode.LeftShift) and flySpd*2.5 or flySpd
            if flyBV and flyBV.Parent then flyBV.Velocity=d*s end
            if flyBG and flyBG.Parent then flyBG.CFrame=CFrame.new(r.Position,r.Position+cam.CFrame.LookVector*10) end
        end)
        sync("fly",true)
    else
        if conns.fly then conns.fly:Disconnect() conns.fly=nil end
        if flyBV then flyBV:Destroy() flyBV=nil end if flyBG then flyBG:Destroy() flyBG=nil end
        sync("fly",false)
    end
end

-- ===== AIMBOT =====
local function aim(on)
    if on then
        if conns.aim then conns.aim:Disconnect() end
        conns.aim=RS.RenderStepped:Connect(function()
            if not fe.aim then conns.aim:Disconnect() conns.aim=nil sync("aim",false) return end
            local c=plr.Character if not c then return end
            local r=c:FindFirstChild("HumanoidRootPart") if not r then return end
            
            if target and target.Character then
                local h=target.Character:FindFirstChild("Humanoid")
                local tr=target.Character:FindFirstChild("HumanoidRootPart")
                local th=target.Character:FindFirstChild("Head")
                if h and h.Health>0 and th and tr then
                    cam.CFrame=CFrame.new(cam.CFrame.Position,th.Position)
                    r.CFrame=CFrame.new(r.Position,Vector3.new(tr.Position.X,r.Position.Y,tr.Position.Z))
                    return
                end
            end
            
            target=nil local md=300
            for _,p in pairs(Players:GetPlayers()) do
                if p~=plr and p.Character then
                    local hd=p.Character:FindFirstChild("Head")
                    local hm=p.Character:FindFirstChild("Humanoid")
                    if hd and hm and hm.Health>0 then
                        local d=(r.Position-hd.Position).Magnitude
                        if d<md then md=d target=p end
                    end
                end
            end
        end)
        sync("aim",true)
    else
        if conns.aim then conns.aim:Disconnect() conns.aim=nil end
        target=nil sync("aim",false)
    end
end

-- ===== AUTO COMBAT =====
local function doCombat()
    if busy then return end
    if not fe.combat then return end
    if not target or not target.Character then return end
    
    local c=plr.Character if not c then return end
    local r=c:FindFirstChild("HumanoidRootPart") if not r then return end
    local tc=target.Character
    local tr=tc:FindFirstChild("HumanoidRootPart")
    local th=tc:FindFirstChild("Humanoid")
    if not tr or not th or th.Health<=0 then return end
    if (r.Position-tr.Position).Magnitude>60 then return end
    
    busy=true
    local sv=r.CFrame
    r.CFrame=tr.CFrame*CFrame.new(0,0,3)
    task.wait(0.04)
    r.CFrame=CFrame.new(r.Position,tr.Position)
    click() fire()
    task.wait(0.15)
    r.CFrame=sv
    task.wait(0.2)
    busy=false
end

local function combat(on)
    if on then
        if conns.combat then conns.combat:Disconnect() end
        conns.combat=mouse.Button1Down:Connect(doCombat)
        sync("combat",true)
    else
        if conns.combat then conns.combat:Disconnect() conns.combat=nil end
        busy=false sync("combat",false)
    end
end

-- ===== ESP =====
local function espCreate(p)
    if p==plr then return end
    local c=p.Character if not c then return end
    local hd=c:FindFirstChild("Head") if not hd then return end
    
    local bg=Instance.new("BillboardGui",hd) bg.Size=UDim2.new(0,150,0,12) bg.AlwaysOnTop=true bg.StudsOffset=Vector3.new(0,2,0) bg.MaxDistance=400
    local tx=Instance.new("TextLabel",bg) tx.Size=UDim2.new(1,0,1,0) tx.BackgroundTransparency=1 tx.Text=p.Name tx.TextColor3=Color3.new(1,1,1) tx.Font=Enum.Font.GothamBold tx.TextSize=8
    local hl=Instance.new("Highlight",c) hl.FillTransparency=0.9 hl.OutlineColor=Color3.new(1,0.2,0.2)
    espBGs[p]=bg espHLs[p]=hl
end

local function espRemove(p)
    if espBGs[p] then espBGs[p]:Destroy() espBGs[p]=nil end
    if espHLs[p] then espHLs[p]:Destroy() espHLs[p]=nil end
end

local function esp(on)
    if on then
        for _,p in pairs(Players:GetPlayers()) do if p~=plr and p.Character then espCreate(p) end end
        if conns.espUp then conns.espUp:Disconnect() end
        conns.espUp=RS.RenderStepped:Connect(function()
            if not fe.esp then return end
            local c=plr.Character if not c then return end
            for p,bg in pairs(espBGs) do
                local pc=p.Character
                if pc and bg then
                    local h=pc:FindFirstChild("Humanoid")
                    if h then
                        local tx=bg:FindFirstChildOfClass("TextLabel")
                        if tx then tx.Text=p.Name.." "..math.floor((h.Health/h.MaxHealth)*100).."%" end
                    end
                end
            end
        end)
        sync("esp",true)
    else
        for p in pairs(espBGs) do if type(p)=="userdata" then espRemove(p) end end
        if conns.espUp then conns.espUp:Disconnect() conns.espUp=nil end
        sync("esp",false)
    end
end

-- ===== BIG HITBOX =====
local function hbCreate(p)
    if p==plr then return end
    local c=p.Character if not c then return end
    local r=c:FindFirstChild("HumanoidRootPart") if not r then return end
    for _,ch in pairs(c:GetChildren()) do if ch.Name=="THB" then ch:Destroy() end end
    
    local b=Instance.new("Part",c) b.Name="THB" b.Size=Vector3.new(hbSize,hbSize,hbSize) b.Transparency=1 b.CanCollide=true b.Anchored=false b.Massless=true
    Instance.new("WeldConstraint",b).Part0=b Instance.new("WeldConstraint",b).Part1=r
    table.insert(hbList,{p=b,pl=p})
end

local function hb(on)
    if on then
        for _,d in pairs(hbList) do if d.p then d.p:Destroy() end end hbList={}
        for _,p in pairs(Players:GetPlayers()) do if p~=plr and p.Character then hbCreate(p) end end
        sync("hb",true)
    else
        for _,d in pairs(hbList) do if d.p then d.p:Destroy() end end hbList={}
        sync("hb",false)
    end
end

