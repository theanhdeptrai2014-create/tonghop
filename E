UIS.InputBegan:Connect(function(i,g)
    if g or i.UserInputType~=Enum.UserInputType.Keyboard then return end
    local k=i.KeyCode
    if k==Enum.KeyCode.F4 then mf.Visible=not mf.Visible
    elseif k==Enum.KeyCode.E then local s=not fe.fly fly(s) sync("fly",s)
    elseif k==Enum.KeyCode.R then local s=not fe.aim aim(s) sync("aim",s)
    elseif k==Enum.KeyCode.G then local s=not fe.combat combat(s) sync("combat",s)
    elseif k==Enum.KeyCode.Y then local s=not fe.esp esp(s) sync("esp",s)
    elseif k==Enum.KeyCode.N then local s=not fe.hb hb(s) sync("hb",s)
    elseif k==Enum.KeyCode.T then local s=not fe.dmg dmg(s) sync("dmg",s)
    elseif k==Enum.KeyCode.P then sv()
    elseif k==Enum.KeyCode.X then destroy() end
end)

plr.CharacterAdded:Connect(function()
    if fe.fly then fe.fly=false fly(false) end
    task.wait(1)
    if fe.esp then for _,p in pairs(Players:GetPlayers()) do if p~=plr and p.Character then espCreate(p) end end end
    if fe.hb then for _,p in pairs(Players:GetPlayers()) do if p~=plr and p.Character then hbCreate(p) end end end
end)

